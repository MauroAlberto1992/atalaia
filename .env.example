# Copy to .env and fill in. Get a key at https://aisstream.io
AISSTREAM_API_KEY=
# Area name from backend/config/areas.toml
MINICOP_AREA=algarve
# Database (docker compose): pick any strong password; it never leaves this file.
POSTGRES_PASSWORD=
# Days of position history to keep (default 30).
MINICOP_RETENTION_DAYS=30
