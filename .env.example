# Copy to .env and fill in. Get a key at https://aisstream.io
AISSTREAM_API_KEY=
# Area name from backend/config/areas.toml
MINICOP_AREA=algarve
# Database (docker compose): pick any strong password; it never leaves this file.
POSTGRES_PASSWORD=
# Days of position history to keep (default 30).
MINICOP_RETENTION_DAYS=30
# SIMULATED patrol-drone sensor for the fusion demo (1 = on, 0 = off). Docker default: on.
MINICOP_SIMULATED_SENSOR=1
# Optional: watch the simulation faster (defaults: 30 s between sweeps, drone at 60 kn,
# one patrol loop in ~77 min). E.g. 1 s and 600 kn: a loop in ~8 min. Only the drone
# is sped up; more sweeps per hour also means more chance clutter confirmations.
MINICOP_SENSOR_SWEEP_S=
MINICOP_DRONE_SPEED_KN=
